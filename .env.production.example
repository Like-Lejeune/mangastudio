# --- Serveur ---
APP_DOMAIN=mangastudio.psikalab.space
API_DOMAIN=apimangastudio.psikalab.space
PUBLIC_BASE_URL=https://apimangastudio.psikalab.space
FRONTEND_URL=https://mangastudio.psikalab.space
POSTGRES_PASSWORD=A_GENERER
SECRET_KEY=A_GENERER
# Votre adresse : vous devenez administrateur à l'inscription.
ADMIN_EMAILS=votre-adresse@exemple.com

# --- Plafond de dépense IA (dollars par jour) ---
AI_DAILY_BUDGET_USD=20
AI_ALERT_RATIO=0.8
BUDGET_TIMEZONE=Africa/Douala
ALERT_WEBHOOK_URL=

# --- Modèles Muse de Meta ---
META_API_KEY=
WRITER_PROVIDER=meta_muse
WRITER_MODEL=muse-wonder-1.0
CHECKER_PROVIDER=meta_muse
CHECKER_MODEL=muse-spark-1.3
IMAGE_PROVIDER=meta_muse
IMAGE_MODEL=muse-image-1.0
IMAGE_MAX_REFS=10
PRICES={"muse-wonder-1.0":{"in":4,"out":20},"muse-spark-1.3":{"in":1.25,"out":4.25},"muse-image-1.0":{"image":0.01}}

# --- TrustChange (clé tc_test_ pour l'instant) ---
TRUSTCHANGE_API_KEY=
TRUSTCHANGE_WEBHOOK_SECRET=
TRUSTCHANGE_SIGNATURE_HEADER=X-TrustChange-Signature
TRUSTCHANGE_TIMESTAMP_HEADER=X-TrustChange-Timestamp