# Copier en .env.production SUR LE VPS (jamais dans git), puis : docker compose --env-file .env.production up -d --build

# --- Serveur ---
APP_DOMAIN=app.votre-domaine.com
API_DOMAIN=api.votre-domaine.com
PUBLIC_BASE_URL=https://api.votre-domaine.com
# Adresses autorisées à appeler l'API, séparées par des virgules : https:// suivi de APP_DOMAIN.
FRONTEND_URL=https://app.votre-domaine.com
POSTGRES_PASSWORD=          # openssl rand -hex 24
SECRET_KEY=                 # openssl rand -hex 32 (l'API refuse de démarrer sans une vraie clé)
# Adresses des administrateurs, séparées par des virgules. Ils le deviennent à l'inscription ou à la connexion.
ADMIN_EMAILS=

# --- Plafond de dépense IA ---
# Dollars par jour (coût calculé avec PRICES). Au-delà, les nouveaux épisodes sont refusés jusqu'au lendemain.
AI_DAILY_BUDGET_USD=20
AI_ALERT_RATIO=0.8
BUDGET_TIMEZONE=Africa/Douala
# Facultatif : webhook Slack, Discord ou Google Chat qui reçoit les alertes (80 % puis 100 %).
ALERT_WEBHOOK_URL=

# --- Modèles Muse de Meta ---
META_API_KEY=
WRITER_PROVIDER=meta_muse
WRITER_MODEL=muse-wonder-1.0
CHECKER_PROVIDER=meta_muse
CHECKER_MODEL=muse-spark-1.3
IMAGE_PROVIDER=meta_muse
IMAGE_MODEL=muse-image-1.0
IMAGE_MAX_REFS=10
PRICES={"muse-wonder-1.0":{"in":4,"out":20},"muse-spark-1.3":{"in":1.25,"out":4.25},"muse-image-1.0":{"image":0.01}}

# --- TrustChange (commencer avec une clé tc_test_…) ---
TRUSTCHANGE_API_KEY=
TRUSTCHANGE_WEBHOOK_SECRET=
TRUSTCHANGE_SIGNATURE_HEADER=X-TrustChange-Signature
TRUSTCHANGE_TIMESTAMP_HEADER=X-TrustChange-Timestamp
