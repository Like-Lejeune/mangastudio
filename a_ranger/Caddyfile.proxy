# Variante quand un autre serveur web (nginx) tient déjà les ports 80 et 443 du VPS.
# nginx fait le HTTPS (certificats certbot) et relaie les deux sous-domaines vers Caddy,
# qui n'écoute qu'en local (127.0.0.1:CADDY_HTTP_PORT). Choisie par CADDY_CONFIG dans .env.production.
{
	auto_https off
	servers {
		# nginx arrive par le réseau Docker : on garde l'adresse du visiteur qu'il transmet
		# (indispensable pour les limites de tentatives de connexion).
		trusted_proxies static private_ranges
	}
}

(securite) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Le front : fichiers statiques ; toute adresse inconnue renvoie index.html.
http://{$APP_DOMAIN} {
	import securite
	# Le site ne charge que ses propres fichiers et parle seulement à l'API ; il ne peut pas être affiché dans un cadre.
	header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://{$API_DOMAIN}; connect-src 'self' https://{$API_DOMAIN}; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	header X-Frame-Options "DENY"
	encode gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Chapitres partagés : page rendue par l'API (aperçu WhatsApp et Facebook), sous l'adresse du site.
	handle /lire/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}

# L'API.
http://{$API_DOMAIN} {
	import securite
	encode gzip
	request_body {
		max_size 8MB
	}
	reverse_proxy api:8000
}
