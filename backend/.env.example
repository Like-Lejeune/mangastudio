# Copier en .env. Sans rien changer, l'API tourne avec SQLite et les fournisseurs factices.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mangastudio
SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
STORAGE_DIR=./storage
# REDIS_URL=redis://localhost:6379   # active le worker ARQ ; sinon tâche asyncio dans l'API

# --- Fournisseurs IA : "fake" (aucune dépense), "meta_muse" ou "openai_compat" ---
# Développement sans dépense :
WRITER_PROVIDER=fake
WRITER_MODEL=fake-writer
CHECKER_PROVIDER=fake
CHECKER_MODEL=fake-checker
IMAGE_PROVIDER=fake
IMAGE_MODEL=fake-image
IMAGE_MAX_REFS=8
PRICES={"fake-writer":{"in":0,"out":0},"fake-checker":{"in":0,"out":0},"fake-image":{"image":0}}

# Modèles Muse de Meta : décommenter ce bloc et supprimer celui du dessus.
# META_API_KEY=
# META_API_BASE=https://api.meta.ai/v1
# WRITER_PROVIDER=meta_muse
# WRITER_MODEL=muse-wonder-1.0
# CHECKER_PROVIDER=meta_muse
# CHECKER_MODEL=muse-spark-1.3
# IMAGE_PROVIDER=meta_muse
# IMAGE_MODEL=muse-image-1.0
# IMAGE_MAX_REFS=10
# Prix à vérifier sur la grille de Meta ($ par million de tokens, $ par image) :
# PRICES={"muse-wonder-1.0":{"in":4,"out":20},"muse-spark-1.3":{"in":1.25,"out":4.25},"muse-image-1.0":{"image":0.01}}

OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PACK=

# --- TrustChange (mobile money) ---
TRUSTCHANGE_BASE_URL=https://api.trustchange.fr
TRUSTCHANGE_API_KEY=            # tc_test_… en test
TRUSTCHANGE_WEBHOOK_SECRET=
# À confirmer avec la documentation TrustChange :
TRUSTCHANGE_SIGNATURE_HEADER=X-TrustChange-Signature
TRUSTCHANGE_TIMESTAMP_HEADER=X-TrustChange-Timestamp
TRUSTCHANGE_SUCCESS_STATUSES=["SUCCESS","SUCCESSFUL","COMPLETED"]
TRUSTCHANGE_FAILURE_STATUSES=["FAILED","CANCELLED","CANCELED","EXPIRED","REJECTED"]
